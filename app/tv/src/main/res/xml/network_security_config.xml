<?xml version="1.0" encoding="utf-8"?>
<!-- Many free TV streams are plain http://, so cleartext is allowed for media.
     The channel list itself is only ever fetched over HTTPS (see Repository.kt). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors><certificates src="system" /></trust-anchors>
    </base-config>
</network-security-config>
